# Development (local Ollama)
ENVIRONMENT=development
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
# 1 = fastest; 2 = default balance when extraction fails
OLLAMA_JSON_MAX_ATTEMPTS=2
OLLAMA_EXTRACT_NUM_PREDICT=2400
OLLAMA_COACHING_NUM_PREDICT=2048
# Truncate CV sent to LLM (0 = full CV, slower). 12000 is usually enough.
MAX_CV_CHARS_FOR_LLM=12000
# Speed toggles (optional)
# USE_MATCH_EXPLAINERS=false
# USE_LLM_SEMANTIC_NARRATIVE=false
# EXPLAINER_SHAP_SAMPLES=12
# EXPLAINER_LIME_SAMPLES=12

# Production (Google Gemini — structured output is more reliable)
# ENVIRONMENT=production
# GEMINI_API_KEY=your_key_here
